# ─────────────────────────────────────────────────────────────────────────────
# SentinelTrack — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (required)
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentineltrack
SENTINEL_DB_USER=sentineluser
SENTINEL_DB_PASSWORD=changeme_strong_password

# Optional: full DSN override (takes precedence if set)
# DATABASE_URL=postgresql+psycopg2://sentineluser:changeme@localhost:5432/sentineltrack

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENTINEL_LOG_LEVEL=INFO

# Set to "true" to enable headless mode (no display window)
SENTINEL_HEADLESS=false

# RTSP credentials (never embed in RTSP URI in config.json)
RTSP_USERNAME=
RTSP_PASSWORD=
